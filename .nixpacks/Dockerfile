FROM ghcr.io/railwayapp/nixpacks:ubuntu-1745885067

ENTRYPOINT ["/bin/bash", "-l", "-c"]
WORKDIR /app/


COPY .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix
RUN nix-env -if .nixpacks/nixpkgs-ffeebf0acf3ae8b29f8c7049cd911b9636efd7e7.nix && nix-collect-garbage -d


ARG ADMIN_EMAIL ADMIN_PANEL_URL CI GMAIL_APP_PASSWORD GMAIL_USER NEXT_PUBLIC_ADMIN_PANEL_URL NEXT_PUBLIC_APP_URL NEXT_PUBLIC_ENCRYPTION_KEY NEXT_PUBLIC_POCKETBASE_URL NEXT_PUBLIC_RAZORPAY_KEY_ID NEXT_PUBLIC_RECAPTCHA_SITE_KEY NEXT_PUBLIC_SMS_API_KEY NEXT_PUBLIC_SMS_ENTITY_ID NEXT_PUBLIC_SMS_GATEWAY_URL NIXPACKS_METADATA NODE_ENV NPM_CONFIG_PRODUCTION RAZORPAY_KEY_SECRET RECAPTCHA_SECRET_KEY SMS_API_KEY SMS_ENTITY_ID SMS_GATEWAY_URL SMS_SENDER SMTP_PASS SMTP_USER
ENV ADMIN_EMAIL=$ADMIN_EMAIL ADMIN_PANEL_URL=$ADMIN_PANEL_URL CI=$CI GMAIL_APP_PASSWORD=$GMAIL_APP_PASSWORD GMAIL_USER=$GMAIL_USER NEXT_PUBLIC_ADMIN_PANEL_URL=$NEXT_PUBLIC_ADMIN_PANEL_URL NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL NEXT_PUBLIC_ENCRYPTION_KEY=$NEXT_PUBLIC_ENCRYPTION_KEY NEXT_PUBLIC_POCKETBASE_URL=$NEXT_PUBLIC_POCKETBASE_URL NEXT_PUBLIC_RAZORPAY_KEY_ID=$NEXT_PUBLIC_RAZORPAY_KEY_ID NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY NEXT_PUBLIC_SMS_API_KEY=$NEXT_PUBLIC_SMS_API_KEY NEXT_PUBLIC_SMS_ENTITY_ID=$NEXT_PUBLIC_SMS_ENTITY_ID NEXT_PUBLIC_SMS_GATEWAY_URL=$NEXT_PUBLIC_SMS_GATEWAY_URL NIXPACKS_METADATA=$NIXPACKS_METADATA NODE_ENV=$NODE_ENV NPM_CONFIG_PRODUCTION=$NPM_CONFIG_PRODUCTION RAZORPAY_KEY_SECRET=$RAZORPAY_KEY_SECRET RECAPTCHA_SECRET_KEY=$RECAPTCHA_SECRET_KEY SMS_API_KEY=$SMS_API_KEY SMS_ENTITY_ID=$SMS_ENTITY_ID SMS_GATEWAY_URL=$SMS_GATEWAY_URL SMS_SENDER=$SMS_SENDER SMTP_PASS=$SMTP_PASS SMTP_USER=$SMTP_USER

# setup phase
# noop

# install phase
ENV NIXPACKS_PATH=/app/node_modules/.bin:$NIXPACKS_PATH
COPY . /app/.
RUN --mount=type=cache,id=9OXRx6EixSU-/root/npm,target=/root/.npm npm ci

# build phase
COPY . /app/.
RUN --mount=type=cache,id=9OXRx6EixSU-next/cache,target=/app/.next/cache --mount=type=cache,id=9OXRx6EixSU-node_modules/cache,target=/app/node_modules/.cache npm run build


RUN printf '\nPATH=/app/node_modules/.bin:$PATH' >> /root/.profile


# start
COPY . /app

CMD ["npm run start"]

